#!/usr/bin/env bash
#MISE description="Continue an existing agent session through its target desk identity"
#USAGE flag "--session <id>" default="" help="Existing Sessions session ID to continue"
#USAGE flag "--desk <path>" default="" help="Desk root path (used to derive --home when omitted)"
#USAGE flag "--home <path>" default="" help="Prepared target home (default: <desk>/home)"
#USAGE flag "--shell <name>" default="" help="Attachable shell name for the continuation"
#USAGE flag "--packet <path>" default="" help="File-backed continuation context"
#USAGE flag "--model <model>" default="" help="Provider/model passed explicitly to sessions wake"
#USAGE flag "--message <message>" default="Read the continuation packet and resume." help="Short wake message"
#USAGE flag "--title <title>" default="agent desk continuation — root handoff" help="Title prepended to the wake message"
#USAGE flag "--identity-source <path>" default="" help="Directory where 'shimmer as <agent>' runs (default: target home)"
#USAGE flag "--startup-timeout <seconds>" default="30" help="Seconds to wait before one final Pi readiness observation"
#USAGE flag "--work-dir <path>" default="" help="Directory for generated launcher (default: temporary directory)"
#USAGE flag "-y --yes" default=#false help="Actually launch; without this, render and print the plan only"
#USAGE arg "<agent>" help="Agent identity that owns the existing session"
#USAGE example "mise run agent:desk:continue quick --session <id> --desk ~/desks/q --shell quick-q-cont --packet /tmp/follow-up.md --model '<model>' --yes" header="Continue Quick under Quick's desk identity"
set -euo pipefail

ROOT="${MISE_CONFIG_ROOT:?MISE_CONFIG_ROOT not set}"
# shellcheck source=.mise/lib/agent_desk.sh
source "$ROOT/.mise/lib/agent_desk.sh"

AGENT="${usage_agent:?agent required}"
SESSION_ID="${usage_session:-}"
DESK_PATH=$(agent_desk_resolve_desk "${usage_desk:-}")
HOME_PATH=$(agent_desk_resolve_home "${usage_home:-}" "$DESK_PATH" || true)
SHELL_NAME="${usage_shell:-}"
PACKET_PATH="${usage_packet:-}"
MODEL="${usage_model:-}"
MESSAGE="${usage_message:-Read the continuation packet and resume.}"
TITLE="${usage_title:-agent desk continuation — root handoff}"
IDENTITY_SOURCE="${usage_identity_source:-$HOME_PATH}"
STARTUP_TIMEOUT="${usage_startup_timeout:-30}"
WORK_DIR="${usage_work_dir:-}"
YES="${usage_yes:-false}"
SESSIONS_BIN="${SESSIONS_BIN:-sessions}"
JQ_BIN="${JQ:-jq}"
GH_BIN="${GH_BIN:-gh}"

validate_agent "$AGENT"
if [ -z "$SESSION_ID" ]; then
  echo "ERROR: --session is required" >&2
  exit 64
fi
agent_desk_validate_name session "$SESSION_ID"
if [ -z "$HOME_PATH" ]; then
  echo "ERROR: --home is required when --desk/home cannot be resolved" >&2
  exit 64
fi
if [ -z "$SHELL_NAME" ]; then
  echo "ERROR: --shell is required" >&2
  exit 64
fi
agent_desk_validate_name shell "$SHELL_NAME"
if [ -z "$PACKET_PATH" ]; then
  echo "ERROR: --packet is required" >&2
  exit 64
fi
if [ -z "$MODEL" ]; then
  echo "ERROR: --model is required" >&2
  exit 64
fi
if ! [[ "$STARTUP_TIMEOUT" =~ ^[1-9][0-9]*$ ]]; then
  echo "ERROR: --startup-timeout must be a positive integer" >&2
  exit 64
fi
if [ ! -f "$PACKET_PATH" ]; then
  echo "ERROR: packet file not found: $PACKET_PATH" >&2
  exit 1
fi
PACKET_PATH=$(agent_desk_abs_file "$PACKET_PATH")
IDENTITY_SOURCE=$(agent_desk_abs_path "$IDENTITY_SOURCE")

if ! command -v "$JQ_BIN" >/dev/null 2>&1; then
  echo "ERROR: jq command not found: $JQ_BIN" >&2
  exit 1
fi
if ! command -v "$SESSIONS_BIN" >/dev/null 2>&1; then
  echo "ERROR: sessions command not found: $SESSIONS_BIN" >&2
  exit 1
fi
EXPECTED_EMAIL="$AGENT@ricon.family"
if ! EXPECTED_SIGNING_KEY=$(agent_desk_clean_git_config_get "$HOME_PATH" user.signingkey); then
  echo "ERROR: prepared target home has no Git signing key: $HOME_PATH" >&2
  exit 1
fi
EXPECTED_GITHUB_LOGIN=$(agent_desk_github_login "$AGENT" "$JQ_BIN")

if [ -z "$WORK_DIR" ]; then
  WORK_DIR=$(mktemp -d "${TMPDIR:-/tmp}/fold-agent-desk-continue.XXXXXX")
else
  mkdir -p "$WORK_DIR"
  WORK_DIR=$(agent_desk_abs_path "$WORK_DIR")
fi
LAUNCHER="$WORK_DIR/continue-$SHELL_NAME.sh"

cat > "$LAUNCHER" <<LAUNCHER
#!/usr/bin/env bash
set -euo pipefail
AGENT=$(agent_desk_single_quote "$AGENT")
SESSION_ID=$(agent_desk_single_quote "$SESSION_ID")
HOME_PATH=$(agent_desk_single_quote "$HOME_PATH")
IDENTITY_SOURCE=$(agent_desk_single_quote "$IDENTITY_SOURCE")
PACKET_PATH=$(agent_desk_single_quote "$PACKET_PATH")
MODEL=$(agent_desk_single_quote "$MODEL")
MESSAGE=$(agent_desk_single_quote "$MESSAGE")
TITLE=$(agent_desk_single_quote "$TITLE")
EXPECTED_EMAIL=$(agent_desk_single_quote "$EXPECTED_EMAIL")
EXPECTED_SIGNING_KEY=$(agent_desk_single_quote "$EXPECTED_SIGNING_KEY")
EXPECTED_GITHUB_LOGIN=$(agent_desk_single_quote "$EXPECTED_GITHUB_LOGIN")
GH_BIN=$(agent_desk_single_quote "$GH_BIN")
SESSIONS_BIN=$(agent_desk_single_quote "$SESSIONS_BIN")

cd "\$HOME_PATH"
LAUNCHER
agent_desk_render_identity_boundary >> "$LAUNCHER"
cat >> "$LAUNCHER" <<'LAUNCHER'
exec "$SESSIONS_BIN" wake "$SESSION_ID" \
  --model "$MODEL" \
  --context-file "$PACKET_PATH" \
  --message "[$TITLE] $MESSAGE"
LAUNCHER
chmod +x "$LAUNCHER"

printf 'Agent desk continuation plan\n\n'
printf 'agent:           %s\n' "$AGENT"
printf 'session:         %s\n' "$SESSION_ID"
printf 'desk:            %s\n' "${DESK_PATH:-'(not resolved)'}"
printf 'home:            %s\n' "$HOME_PATH"
printf 'shell:           %s\n' "$SHELL_NAME"
printf 'packet:          %s\n' "$PACKET_PATH"
printf 'model:           %s\n' "$MODEL"
printf 'identity-source: %s\n' "$IDENTITY_SOURCE"
printf 'startup window:  %ss plus one final observation\n' "$STARTUP_TIMEOUT"
printf 'launcher:        %s\n' "$LAUNCHER"

if [ "$YES" != "true" ]; then
  printf '\ndry-run: pass --yes to continue with shell run.\n'
  exit 0
fi

BASELINE_KEYS="$WORK_DIR/baseline-process-keys.txt"
if ! session_processes=$("$SESSIONS_BIN" ps --all --json); then
  echo "ERROR: could not inspect Sessions processes before continuation" >&2
  exit 1
fi
if ! printf '%s\n' "$session_processes" | "$JQ_BIN" -e 'type == "array"' >/dev/null; then
  echo "ERROR: Sessions process output is not a JSON array" >&2
  exit 1
fi
known_count=$(printf '%s\n' "$session_processes" | "$JQ_BIN" -r --arg id "$SESSION_ID" '[.[] | select(.session_id == $id)] | length')
if [ "$known_count" -eq 0 ]; then
  echo "ERROR: Sessions has no process history for session: $SESSION_ID" >&2
  exit 1
fi
printf '%s\n' "$session_processes" |
  "$JQ_BIN" -r --arg id "$SESSION_ID" \
    '.[] | select(.session_id == $id) | [(.pid | tostring), (.process_start_id // "")] | @tsv' \
    > "$BASELINE_KEYS"

printf '\nlaunching continuation shell %s from %s\n' "$SHELL_NAME" "$HOME_PATH"
"$AGENT_DESK_SHELL_BIN" run --cwd "$HOME_PATH" "$SHELL_NAME" "$LAUNCHER"

printf '\nwaiting %ss plus one final observation for the continued Pi process\n' "$STARTUP_TIMEOUT"
started_at=$SECONDS
while :; do
  final_observation=false
  if [ $((SECONDS - started_at)) -ge "$STARTUP_TIMEOUT" ]; then
    final_observation=true
  fi
  if ! agent_desk_shell_status "$SHELL_NAME" >/dev/null 2>&1; then
    echo "ERROR: continuation shell exited before Pi became ready" >&2
    if ! mise run -q agent:desk:smoke --shell "$SHELL_NAME"; then
      : # Preserve the primary continuation failure if diagnostics also fail.
    fi
    exit 1
  fi

  if ! session_processes=$("$SESSIONS_BIN" ps --all --json); then
    echo "ERROR: could not inspect Sessions processes while waiting for continuation" >&2
    exit 1
  fi
  if ! printf '%s\n' "$session_processes" | "$JQ_BIN" -e 'type == "array"' >/dev/null; then
    echo "ERROR: Sessions process output is not a JSON array" >&2
    exit 1
  fi
  ready_key=$(
    printf '%s\n' "$session_processes" |
      "$JQ_BIN" -r --arg id "$SESSION_ID" --arg cwd "$HOME_PATH" \
        '.[] | select(.session_id == $id and .cwd == $cwd and .status == "live" and .harness == "pi") | [(.pid | tostring), (.process_start_id // "")] | @tsv' |
      while IFS= read -r process_key; do
        [ -n "$process_key" ] || continue
        if ! grep -Fqx "$process_key" "$BASELINE_KEYS"; then
          printf '%s\n' "$process_key"
          break
        fi
      done
  )
  if [ -n "$ready_key" ]; then
    printf 'Agent continuation ready\n\n'
    printf 'session: %s\n' "$SESSION_ID"
    printf 'cwd:     %s\n' "$HOME_PATH"
    printf 'attach:  shell attach %s\n' "$SHELL_NAME"
    exit 0
  fi

  if [ "$final_observation" = true ]; then
    break
  fi
  if [ $((SECONDS - started_at)) -lt "$STARTUP_TIMEOUT" ]; then
    sleep 1
  fi
done

echo "ERROR: no new live Pi process appeared for session $SESSION_ID during the ${STARTUP_TIMEOUT}s window or final observation" >&2
if ! mise run -q agent:desk:smoke --shell "$SHELL_NAME"; then
  : # Preserve the primary continuation timeout if diagnostics also fail.
fi
exit 1
