#!/usr/bin/env bash
#MISE description="Smoke-check an agent home after bootstrap or adoption"
#USAGE flag "--home <path>" default="" help="Target home repo (default: AGENT_HOME; required when unset)"
#USAGE flag "--skip-mise" default=#false help="Run read-only repo/notes/module checks without preparation or welcome"
#USAGE flag "-y --yes" default=#false help="Run mise trust/install, agent:prepare, welcome, and readiness checks"
#USAGE arg "<agent>" help="Agent name"
#USAGE example "mise run homes:smoke iris --home /path/to/desk/home" header="Preview preparation and smoke checks"
#USAGE example "mise run homes:smoke iris --yes" header="Prepare and smoke-check AGENT_HOME"
#USAGE example "mise run homes:smoke iris --skip-mise" header="Inspect AGENT_HOME without preparation"
set -euo pipefail

ROOT="${MISE_CONFIG_ROOT:?MISE_CONFIG_ROOT not set}"
# shellcheck source=.mise/lib/homes.sh
source "$ROOT/.mise/lib/homes.sh"

AGENT="${usage_agent:?agent required}"
HOME_PATH=$(homes_resolve_home "${usage_home:-}")
YES="${usage_yes:-false}"
SKIP_MISE="${usage_skip_mise:-false}"

validate_agent "$AGENT"
require_tool "$GIT_BIN"
homes_require_git_repo "$HOME_PATH"

printf 'Homes smoke\n\n'
printf 'agent: %s\n' "$AGENT"
printf 'home:  %s\n\n' "$HOME_PATH"

if [ "$SKIP_MISE" != "true" ] && [ "$YES" != "true" ]; then
  echo "dry-run: would trust/install mise tools, run agent:prepare, trust present modules,"
  echo "run welcome (which may access live services), then inspect repo/notes/modules"
  echo "rerun with --yes to execute, or --skip-mise for read-only checks"
  exit 0
fi

printf '== repo ==\n'
"$GIT_BIN" -C "$HOME_PATH" status --short --branch
homes_require_clean_worktree "$HOME_PATH"

if [ "$SKIP_MISE" != "true" ] && homes_has_mise_config "$HOME_PATH"; then
  printf '\n== mise ==\n'
  require_tool "$MISE_BIN"
  (cd "$HOME_PATH" && "$MISE_BIN" trust && "$MISE_BIN" install)
  if [ -x "$HOME_PATH/.mise/tasks/agent/prepare" ]; then
    (cd "$HOME_PATH" && "$MISE_BIN" run agent:prepare)
  else
    echo "agent:prepare: not present"
  fi
  homes_trust_mise_surface "$HOME_PATH"
  if [ -x "$HOME_PATH/.mise/tasks/welcome" ] || [ -f "$HOME_PATH/.mise/tasks/welcome" ]; then
    (cd "$HOME_PATH" && "$MISE_BIN" welcome)
  else
    echo "welcome: not present"
  fi
else
  printf '\n== mise ==\n'
  echo "skipped"
fi

if [ -f "$HOME_PATH/notes/.manifest" ]; then
  printf '\n== notes ==\n'
  if command -v "$NOTES_BIN" >/dev/null 2>&1; then
    (cd "$HOME_PATH" && "$NOTES_BIN" status && "$NOTES_BIN" changes --summary)
  else
    echo "ERROR: notes/.manifest exists but notes tool is unavailable" >&2
    exit 1
  fi
fi

if [ -f "$HOME_PATH/.modules/manifest" ]; then
  printf '\n== modules ==\n'
  if command -v "$MODULES_BIN" >/dev/null 2>&1; then
    (cd "$HOME_PATH" && "$MODULES_BIN" status)
  else
    echo "ERROR: .modules/manifest exists but modules tool is unavailable" >&2
    exit 1
  fi
fi
